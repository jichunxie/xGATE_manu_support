# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*~
*.swp

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# ---- R ----
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ---- private / local configuration (never commit) ----
configs/paths.yaml
configs/datasets.yaml
configs/*.local.yaml

# ---- raw / large data (obtain separately; see data/README.md) ----
data/**
!data/README.md
!data/.gitkeep
*.rds
*.RDS
*.h5
*.h5ad
*.mtx
*.pkl
*.npz
*.loom

# ---- generated results & figures (regenerated by scripts) ----
results/**
!results/.gitkeep
figures/**
!figures/.gitkeep
outputs/**
analysis/**/figures/**
analysis/**/results/**
# capital-R Results/ dirs: some notebooks write panels here — ignore generated
# contents but keep the small CSV inputs the figure notebooks read.
**/Results/**
!analysis/figure3_benchmark_senescence_aab/senescence/Results/final_analysis.csv
!analysis/supplementary/misc/Results/pathway_comp_time_results.csv
logs/

# large embedding CSVs shipped in the original repo (regenerated by scripts)
analysis/figure2_pancreas/Embeddings/
analysis/figure2_pancreas/batch_effect/data/

# ---- internal staging (never commit) ----
excluded_from_repo/

# ---- backups / temp / logs / rendered notebooks ----
*.bak
*.bak_*
*.log
*.nohup
*.tmp
*.html
slurm-*.out
